# 在高德开放平台创建 Web 服务应用并获取 Web 服务 Key 后填入。
# 不要把真实 Key 提交到代码仓库，也不要放进浏览器页面。
AMAP_WEB_KEY=

# OpenAI-compatible Chat Completions 接口（可用 DeepSeek、通义千问等服务）
# DeepSeek V4 Flash 示例：LLM_BASE_URL=https://api.deepseek.com，LLM_MODEL=deepseek-v4-flash
# 通义千问示例：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，LLM_MODEL=qwen-plus
# API Key 仅保存在本地 .env，不要发到聊天或写进前端代码。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# 本地服务端口（可选）
PORT=4173
